# Forge installers / generated jars
####################################
SERVER/forge-*-installer.jar
SERVER/forge-*-installer.jar.log

####################################
# Explicitly preserve project content
####################################


# KubeJS scripts and assets
!CLIENT/kubejs/
!CLIENT/kubejs/**
!SERVER/kubejs/
!SERVER/kubejs/**

# Other gameplay scripts
!CLIENT/scripts/
!CLIENT/scripts/**
!SERVER/scripts/
!SERVER/scripts/**

# Documentation
!README.md
!CHANGELOG.md
!CONFIG_NOTES.md
!*.md

# Ignore generated data within configs
**/config/**/cache/
**/config/**/caches/
**/config/**/spark/
**/config/spark/
**/config/**/world/
**/config/**/server/

# Gitignore backup
.gitignore.backup

# Local project backups
/backups/

# Python bytecode
__pycache__/
*.pyc

