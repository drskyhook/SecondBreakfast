####################################
# Mod binaries
####################################
CLIENT/mods/*.jar
SERVER/mods/*.jar

# Keep mod manifests and lock files
!CLIENT/mods/*.txt
!SERVER/mods/*.txt
!CLIENT/mods/*.json
!SERVER/mods/*.json
!CLIENT/mods/.index/
!SERVER/mods/.index/
!CLIENT/mods/.index/**
!SERVER/mods/.index/**

